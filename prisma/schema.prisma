// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hero {
  id           String   @id @default(cuid())
  name         String
  title        String
  subtitle     String
  description  String
  ctaText      String   @default("View My Work")
  ctaLink      String   @default("#projects")
  avatarUrl    String?
  resumeUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  company      String
  role         String
  startDate    String
  endDate      String?
  current      Boolean  @default(false)
  description  String
  technologies String[]
  logoUrl      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  tags        String[]
  category    ProjectCategory
  featured    Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ProjectCategory {
  WEBSITE
  UIUX
  DATA_ANALYSIS
  GRAPHIC_DESIGN
}

model Skill {
  id        String      @id @default(cuid())
  name      String
  level     Int         // 0-100
  category  SkillCategory
  icon      String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  DESIGN
  DATA
  DEVOPS
  OTHER
}

model Contact {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  location  String?
  github    String?
  linkedin  String?
  twitter   String?
  dribbble  String?
  behance   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
